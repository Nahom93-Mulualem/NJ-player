<Window x:Class="NJPlayer.App.Overlay.ControlsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NJPlayer.App.Views"
        mc:Ignorable="d"
        Title="Controls Overlay"
        MinWidth="480" MinHeight="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        AllowDrop="True"
        DragOver="Overlay_DragOver"
        Drop="Overlay_Drop"
        MouseMove="Window_MouseMove"
        MouseLeave="Window_MouseLeave"
        KeyDown="Window_KeyDown">

    <Grid x:Name="RootGrid" Background="Transparent" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">
        <!-- TOP BAR (36px, surface at 85% opacity, window buttons) -->
        <Border x:Name="TopBar"
                Height="36"
                VerticalAlignment="Top"
                Background="{StaticResource Surface85Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title + Mode Switcher -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,12,0">
                    <Image Source="../Assets/logo.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="NJ Player" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- Mode Switcher Pill (Video / Music) -->
                    <Button x:Name="ModeSwitcherButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Switch Player Mode (Ctrl+M)" Click="ModeSwitcher_Click" Width="Auto" Height="26" Padding="6,0">
                        <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ModeIcon" Text="🎬" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock x:Name="ModeText" Text="VIDEO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- Media Title -->
                <TextBlock Grid.Column="1" x:Name="OverlayTitleText"
                           Text="NJ Player - Fast. Dark. Yours."
                           FontSize="12"
                           Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="8,0"/>

                <!-- Window Buttons (Trimmer, Downloader, Equalizer, Settings, Hotkeys, Always on top, Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="VisualizerToggleBtn" Style="{StaticResource CaptionButtonStyle}" ToolTip="Toggle Visualizer / Cover View (F4)" Click="VisualizerToggleBtn_Click" Visibility="Collapsed" Width="Auto" Padding="8,0" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="VisualizerToggleIcon" Text="📊" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock x:Name="VisualizerToggleText" Text="Visualizer" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TrimmerButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Lossless Trimmer" Click="TrimmerButton_Click">
                        <TextBlock Text="✂" FontSize="11" />
                    </Button>
                    <Button x:Name="DownloaderButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Online Downloader" Click="DownloaderButton_Click">
                        <TextBlock Text="📥" FontSize="11" />
                    </Button>
                    <Button x:Name="OnlineRadioButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Online Radio &amp; Visualizer" Click="OnlineRadioButton_Click">
                        <TextBlock Text="📻" FontSize="11" />
                    </Button>
                    <Button x:Name="EqualizerButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Equalizer (E)" Click="EqualizerButton_Click">
                        <TextBlock Text="🎚" FontSize="11" />
                    </Button>
                    <Button x:Name="GeneralSettingsButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Settings" Click="GeneralSettingsButton_Click">
                        <TextBlock Text="⚙" FontSize="11" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Hotkey Settings" Click="SettingsButton_Click">
                        <TextBlock Text="⌨" FontSize="12" />
                    </Button>
                    <Button x:Name="OverflowButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="More Features" Visibility="Collapsed" Click="OverflowButton_Click">
                        <TextBlock Text="⋯" FontSize="16" FontWeight="Bold" Margin="0,-4,0,0" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="OverflowMenu">
                                <MenuItem Header="✂ Lossless Trimmer" Click="TrimmerButton_Click" />
                                <MenuItem Header="📥 Online Downloader" Click="DownloaderButton_Click" />
                                <MenuItem Header="📻 Online Radio &amp; Visualizer" Click="OnlineRadioButton_Click" />
                                <MenuItem Header="🎚 Equalizer (E)" Click="EqualizerButton_Click" />
                                <MenuItem Header="⚙ General Settings" Click="GeneralSettingsButton_Click" />
                                <MenuItem Header="⌨ Hotkey Settings" Click="SettingsButton_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="PinButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Always on Top (T)" Click="PinButton_Click">
                        <TextBlock x:Name="PinIcon" Text="📌" FontSize="11" />
                    </Button>
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Minimize" Click="MinButton_Click">
                        <TextBlock Text="―" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Maximize / Restore (F)" Click="MaxButton_Click">
                        <TextBlock x:Name="MaxIcon" Text="⬜" FontSize="10" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="Close" Click="CloseButton_Click">
                        <TextBlock Text="✕" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Visualizer Floating Overlay Controls (visible when visualizer is active) -->
        <Border x:Name="VisualizerFloatingControls" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,46,16,0" Visibility="Collapsed">
            <Border Background="{StaticResource Surface85Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ReturnToCoverBtn" Style="{StaticResource PrimaryButtonStyle}" Height="28" Padding="10,0" ToolTip="Return to Cover View (F4)" Click="ReturnToCoverBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Cover View" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="VisualizerStyleBtn" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="8,0" Margin="6,0,0,0" ToolTip="Switch Visualizer Style (Bars / Waveform / Spectrum)" Click="VisualizerStyleBtn_Click">
                        <TextBlock x:Name="VisualizerStyleBtnText" Text="📊 Bars" FontSize="11"/>
                    </Button>
                    <Button x:Name="VisualizerBgBtn" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="8,0" Margin="6,0,0,0" ToolTip="Set Custom Background Image or Video (jpg, png, mp4)" Click="VisualizerBgBtn_Click">
                        <TextBlock Text="🌄 Background" FontSize="11"/>
                    </Button>
                    <Button x:Name="VisualizerClearBgBtn" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="4,0,0,0" ToolTip="Clear Background" Click="VisualizerClearBgBtn_Click">
                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- BOTTOM CONTROL BAR (72px, gradient transparent to 92% bg) -->
        <Border x:Name="BottomBar"
                Height="72"
                VerticalAlignment="Bottom"
                Background="{StaticResource BottomBarGradientBrush}"
                Padding="16,0,16,8">
            <Grid VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Custom Seekbar (flex) with hover thumbnail preview -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <views:PlayerSeekbar x:Name="Seekbar" SeekRequested="Seekbar_SeekRequested" />
                </Grid>

                <!-- Row 1: Left controls, time labels, right controls -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Playback controls -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Skip Backward 10s -->
                        <Button x:Name="SkipBackwardButton"
                                Style="{StaticResource IconButton}"
                                ToolTip="Skip Backward 10s (Left Arrow)"
                                PreviewMouseLeftButtonDown="SkipBackward_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SeekButton_PreviewMouseLeftButtonUp"
                                MouseLeave="SeekButton_MouseLeave"
                                Margin="0,0,4,0">
                            <TextBlock Text="⏪" FontSize="13" />
                        </Button>

                        <!-- Play/Pause -->
                        <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" ToolTip="Play / Pause (Space)" Click="PlayPause_Click">
                            <TextBlock x:Name="PlayPauseIcon" Text="▶" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                        </Button>

                        <!-- Skip Forward 10s -->
                        <Button x:Name="SkipForwardButton"
                                Style="{StaticResource IconButton}"
                                ToolTip="Skip Forward 10s (Right Arrow)"
                                PreviewMouseLeftButtonDown="SkipForward_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SeekButton_PreviewMouseLeftButtonUp"
                                MouseLeave="SeekButton_MouseLeave"
                                Margin="4,0,0,0">
                            <TextBlock Text="⏩" FontSize="13" />
                        </Button>

                        <!-- Time display -->
                        <TextBlock x:Name="OverlayTimeText"
                                   Text="00:00 / 00:00"
                                   FontFamily="{StaticResource TimeFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </StackPanel>

                    <!-- Center Spacer -->
                    <Border Grid.Column="1" />

                    <!-- Right: Volume, Speed, Fullscreen -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Volume Icon Button -->
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" ToolTip="Mute (M)" Click="MuteButton_Click">
                            <TextBlock x:Name="VolumeIcon" Text="🔊" FontSize="13" />
                        </Button>
                        <!-- Volume Slider -->
                        <Slider x:Name="VolumeSlider"
                                Style="{StaticResource PlayerSliderStyle}"
                                Width="75"
                                Minimum="0"
                                Maximum="100"
                                Value="100"
                                VerticalAlignment="Center"
                                Margin="4,0,10,0"
                                ValueChanged="VolumeSlider_ValueChanged" />

                        <!-- Subtitles Button -->
                        <Button x:Name="SubtitleButton" Style="{StaticResource IconButton}" ToolTip="Subtitles / Tracks" Click="SubtitleButton_Click" Margin="0,0,4,0">
                            <TextBlock Text="💬" FontSize="13" />
                        </Button>

                        <!-- Playlist Button -->
                        <Button x:Name="PlaylistButton" Style="{StaticResource IconButton}" ToolTip="Playlist (Ctrl+L)" Click="PlaylistButton_Click" Margin="0,0,4,0">
                            <TextBlock x:Name="PlaylistIcon" Text="📋" FontSize="13" />
                        </Button>

                        <!-- Fullscreen Button -->
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" ToolTip="Fullscreen (F)" Click="FullscreenButton_Click">
                            <TextBlock x:Name="FullscreenIcon" Text="⛶" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <!-- Playlist Slide-In Drawer (340px from right edge per DESIGN.md section 5) -->
        <views:PlaylistDrawer x:Name="Drawer" Visibility="Collapsed" />

        <!-- On-Screen Notification Toast (bottom-center, auto-hide 2s per DESIGN.md) -->
        <views:ToastOverlay x:Name="Toast" />
    </Grid>
</Window>

