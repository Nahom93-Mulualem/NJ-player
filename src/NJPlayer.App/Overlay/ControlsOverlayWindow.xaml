<Window x:Class="NJPlayer.App.Overlay.ControlsOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NJPlayer.App.Views"
        mc:Ignorable="d"
        Title="Controls Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        MouseMove="Window_MouseMove"
        MouseLeave="Window_MouseLeave">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- TOP BAR (36px, surface at 85% opacity, window buttons) -->
        <Border x:Name="TopBar"
                Height="36"
                VerticalAlignment="Top"
                Background="{StaticResource Surface85Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Icon & Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                    <Image Source="../Assets/app_16x16.png" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="NJ Player" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Media Title -->
                <TextBlock Grid.Column="1" x:Name="OverlayTitleText"
                           Text="NJ Player - Fast. Dark. Yours."
                           FontSize="12"
                           Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="8,0"/>

                <!-- Window Buttons (Trimmer, Downloader, Equalizer, Settings, Hotkeys, Always on top, Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TrimmerButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Lossless Trimmer" Click="TrimmerButton_Click">
                        <TextBlock Text="✂" FontSize="11" />
                    </Button>
                    <Button x:Name="DownloaderButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Online Downloader" Click="DownloaderButton_Click">
                        <TextBlock Text="📥" FontSize="11" />
                    </Button>
                    <Button x:Name="EqualizerButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Equalizer (E)" Click="EqualizerButton_Click">
                        <TextBlock Text="🎚" FontSize="11" />
                    </Button>
                    <Button x:Name="GeneralSettingsButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Settings" Click="GeneralSettingsButton_Click">
                        <TextBlock Text="⚙" FontSize="11" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Hotkey Settings" Click="SettingsButton_Click">
                        <TextBlock Text="⌨" FontSize="12" />
                    </Button>
                    <Button x:Name="PinButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Always on Top (T)" Click="PinButton_Click">
                        <TextBlock x:Name="PinIcon" Text="📌" FontSize="11" />
                    </Button>
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Minimize" Click="MinButton_Click">
                        <TextBlock Text="―" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButtonStyle}" ToolTip="Maximize / Restore (F)" Click="MaxButton_Click">
                        <TextBlock x:Name="MaxIcon" Text="⬜" FontSize="10" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="Close" Click="CloseButton_Click">
                        <TextBlock Text="✕" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BOTTOM CONTROL BAR (72px, gradient transparent to 92% bg) -->
        <Border x:Name="BottomBar"
                Height="72"
                VerticalAlignment="Bottom"
                Background="{StaticResource BottomBarGradientBrush}"
                Padding="16,0,16,8">
            <Grid VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Custom Seekbar (flex) with hover thumbnail preview -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <views:PlayerSeekbar x:Name="Seekbar" SeekRequested="Seekbar_SeekRequested" />
                </Grid>

                <!-- Row 1: Left controls, time labels, right controls -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Playback controls -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Play/Pause -->
                        <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" ToolTip="Play / Pause (Space)" Click="PlayPause_Click">
                            <TextBlock x:Name="PlayPauseIcon" Text="▶" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                        </Button>
                        <!-- Stop -->
                        <Button x:Name="StopButton" Style="{StaticResource IconButton}" ToolTip="Stop" Click="Stop_Click" Margin="4,0,0,0">
                            <TextBlock Text="⏹" FontSize="12" />
                        </Button>

                        <!-- Time display -->
                        <TextBlock x:Name="OverlayTimeText"
                                   Text="00:00 / 00:00"
                                   FontFamily="{StaticResource TimeFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </StackPanel>

                    <!-- Center Spacer -->
                    <Border Grid.Column="1" />

                    <!-- Right: Volume, Speed, Fullscreen -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Volume Icon Button -->
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" ToolTip="Mute (M)" Click="MuteButton_Click">
                            <TextBlock x:Name="VolumeIcon" Text="🔊" FontSize="13" />
                        </Button>
                        <!-- Volume Slider -->
                        <Slider x:Name="VolumeSlider"
                                Style="{StaticResource PlayerSliderStyle}"
                                Width="75"
                                Minimum="0"
                                Maximum="100"
                                Value="100"
                                VerticalAlignment="Center"
                                Margin="4,0,10,0"
                                ValueChanged="VolumeSlider_ValueChanged" />

                        <!-- Subtitles Button -->
                        <Button x:Name="SubtitleButton" Style="{StaticResource IconButton}" ToolTip="Subtitles / Tracks" Click="SubtitleButton_Click" Margin="0,0,4,0">
                            <TextBlock Text="💬" FontSize="13" />
                        </Button>

                        <!-- Playlist Button -->
                        <Button x:Name="PlaylistButton" Style="{StaticResource IconButton}" ToolTip="Playlist (Ctrl+L)" Click="PlaylistButton_Click" Margin="0,0,4,0">
                            <TextBlock x:Name="PlaylistIcon" Text="📋" FontSize="13" />
                        </Button>

                        <!-- Fullscreen Button -->
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" ToolTip="Fullscreen (F)" Click="FullscreenButton_Click">
                            <TextBlock x:Name="FullscreenIcon" Text="⛶" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <!-- Playlist Slide-In Drawer (340px from right edge per DESIGN.md section 5) -->
        <views:PlaylistDrawer x:Name="Drawer" Visibility="Collapsed" />

        <!-- On-Screen Notification Toast (bottom-center, auto-hide 2s per DESIGN.md) -->
        <views:ToastOverlay x:Name="Toast" />
    </Grid>
</Window>

