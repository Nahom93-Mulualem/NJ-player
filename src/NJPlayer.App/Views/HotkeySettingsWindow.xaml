<Window x:Class="NJPlayer.App.Views.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hotkey Settings"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="0"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="12" Opacity="0.45" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <TextBlock Text="⌨ Hotkey Settings" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CloseCaptionButtonStyle}" Click="Close_Click">
                        <TextBlock Text="✕" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- Conflict Banner (Visible only if conflicts exist) -->
            <Border Grid.Row="1" x:Name="ConflictBanner" Background="#33FF5C6C" BorderBrush="{StaticResource DangerBrush}" BorderThickness="0,0,0,1" Padding="14,8" Visibility="Collapsed">
                <TextBlock x:Name="ConflictText" Text="⚠️ Conflict detected" Foreground="{StaticResource DangerBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <!-- Hotkeys List -->
            <DataGrid Grid.Row="2" x:Name="HotkeysGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      Background="Transparent"
                      RowBackground="{StaticResource SurfaceRaisedBrush}"
                      AlternatingRowBackground="{StaticResource SurfaceBrush}"
                      Foreground="{StaticResource TextBrush}"
                      BorderThickness="0"
                      Margin="16,12"
                      SelectionMode="Single"
                      SelectionChanged="HotkeysGrid_SelectionChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Action" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Shortcut" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#1A00E5FF" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Gesture}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource TimeFont}" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bottom Actions -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,12,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="RecordingPrompt" Text="Select a row, then press any key combination to rebind..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Reset Defaults" Style="{StaticResource IconButton}" Width="110" Foreground="{StaticResource DangerBrush}" Margin="0,0,12,0" Click="ResetDefaults_Click" />
                        <Button Content="Save &amp; Apply" Style="{StaticResource PrimaryButton}" Click="SaveApply_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
