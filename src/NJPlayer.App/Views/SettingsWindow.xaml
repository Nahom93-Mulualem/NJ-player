<Window x:Class="NJPlayer.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings - NJ Player"
        Height="540" Width="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="0"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="12" Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <TextBlock Text="⚙ Settings" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CloseCaptionButtonStyle}" Click="Close_Click">
                        <TextBlock Text="✕" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,18">
                    <!-- Section 1: Playback & Decoding -->
                    <TextBlock Text="PLAYBACK &amp; DECODING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />

                    <!-- Resume Toggle -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Resume Playback Position" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Automatically remembers where you stopped watching each video." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="ResumeCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" />
                        </Grid>
                    </Border>

                    <!-- Hardware Decoding Selector -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Hardware Acceleration (hwdec)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="GPU decoding method passed to libmpv." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="HwdecCombo" HorizontalAlignment="Right" VerticalAlignment="Center" Width="140" Background="{StaticResource SurfaceRaisedBrush}" Foreground="{StaticResource TextBrush}">
                                <ComboBoxItem Content="auto-safe (Recommended)" IsSelected="True" Tag="auto-safe" />
                                <ComboBoxItem Content="d3d11va (Direct3D 11)" Tag="d3d11va" />
                                <ComboBoxItem Content="nvdec (NVIDIA)" Tag="nvdec" />
                                <ComboBoxItem Content="no (Software Only)" Tag="no" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Section 2: Window & Environment -->
                    <TextBlock Text="WINDOW &amp; STORAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,10" />

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Remember Window Size and Position" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Restores previous window bounds when reopening the player." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="RememberBoundsCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" />
                        </Grid>
                    </Border>

                    <!-- Mode Indicator & Storage Directory -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="14,10" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Storage Mode: " FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                <Border x:Name="ModeBadge" Background="#1A00E5FF" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock x:Name="ModeText" Text="Standard (%APPDATA%)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="StoragePathText" Text="C:\Users\..." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Section 3: Privacy & Clear Actions -->
                    <TextBlock Text="PRIVACY &amp; DATA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,10" />

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Recent Files &amp; Resume Cache" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="CacheStatsText" Text="0 recent files, 0 resume positions" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Clear Recent" Style="{StaticResource IconButton}" Width="95" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0" Click="ClearRecent_Click" />
                                <Button Content="Clear Resume" Style="{StaticResource IconButton}" Width="95" Foreground="{StaticResource DangerBrush}" Click="ClearResume_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Section 4: File Associations (Inno Setup Info) -->
                    <Border Background="#1A212A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="ℹ Windows File Associations" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="To keep your registry clean, file associations are not applied automatically during dev runs. They will be registered by the Inno Setup installer at install time." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,8" />
                            <Button Content="View Installer Snippet" Style="{StaticResource IconButton}" Width="150" HorizontalAlignment="Left" Foreground="{StaticResource AccentBrush}" Click="ViewSnippet_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer: Save & Close -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,12,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancel" Style="{StaticResource IconButton}" Width="80" Margin="0,0,10,0" Click="Close_Click" />
                    <Button Content="Save &amp; Apply" Style="{StaticResource PrimaryButton}" Click="SaveApply_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
