<UserControl x:Class="NJPlayer.App.Views.PlayerSeekbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="24"
             Focusable="True"
             Cursor="Hand"
             Background="Transparent"
             FocusVisualStyle="{x:Null}"
             MouseEnter="Seekbar_MouseEnter"
             MouseLeave="Seekbar_MouseLeave"
             MouseMove="Seekbar_MouseMove"
             MouseLeftButtonDown="Seekbar_MouseLeftButtonDown"
             MouseLeftButtonUp="Seekbar_MouseLeftButtonUp"
             KeyDown="Seekbar_KeyDown"
             GotFocus="Seekbar_GotFocus"
             LostFocus="Seekbar_LostFocus"
             SizeChanged="Seekbar_SizeChanged">

    <Grid VerticalAlignment="Stretch">
        <!-- Focus Accent Outline Ring -->
        <Border x:Name="FocusRing"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}"
                Opacity="0"
                Margin="0,1" />

        <!-- Track Container (Grows from 4px to 8px on hover) -->
        <Grid x:Name="TrackGrid" Height="4" VerticalAlignment="Center" ClipToBounds="True">
            <!-- 1. Background Track (Border color) -->
            <Border x:Name="BackgroundTrack" Background="{StaticResource BorderBrush}" CornerRadius="2" />

            <!-- 2. Buffered Range Track (TextMuted at 35%) -->
            <Border x:Name="BufferedTrack"
                    HorizontalAlignment="Left"
                    Width="0"
                    Background="#598B98A5"
                    CornerRadius="2" />

            <!-- 3. Played Range Track (Accent Cyan) -->
            <Border x:Name="PlayedTrack"
                    HorizontalAlignment="Left"
                    Width="0"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="2" />

            <!-- 4. Chapter Gaps Canvas -->
            <Canvas x:Name="ChapterCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>

        <!-- Scrubbing Thumb (14px circle, appears on hover or dragging) -->
        <Canvas VerticalAlignment="Center" Height="14" IsHitTestVisible="False">
            <Ellipse x:Name="Thumb"
                     Width="14" Height="14"
                     Fill="{StaticResource AccentBrush}"
                     Stroke="{StaticResource BgBrush}"
                     StrokeThickness="2"
                     Opacity="0"
                     Canvas.Left="-7" />
        </Canvas>

        <!-- Hover Preview Popup (160x90 thumbnail + instant time label, clamped inside window) -->
        <Popup x:Name="HoverPopup"
               Placement="Top"
               PlacementTarget="{Binding ElementName=TrackGrid}"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               IsOpen="False">
            <Border Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    Padding="3"
                    Margin="0,0,0,8">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.5" />
                </Border.Effect>
                <Grid Width="160" Height="90">
                    <!-- Thumbnail preview image -->
                    <Border CornerRadius="5" ClipToBounds="True" Background="#0B0E12">
                        <Image x:Name="PopupImage" Stretch="UniformToFill" />
                    </Border>

                    <!-- Loading placeholder text if thumbnail not ready -->
                    <TextBlock x:Name="PopupLoadingText"
                               Text="NJ"
                               FontWeight="Bold"
                               FontSize="18"
                               Foreground="#338B98A5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Visible" />

                    <!-- Instant Time Label (clamped above or inside) -->
                    <Border VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Background="#D90B0E12"
                            CornerRadius="4"
                            Padding="8,2"
                            Margin="0,0,0,4">
                        <TextBlock x:Name="PopupTimeText"
                                   Text="00:00"
                                   FontFamily="{StaticResource TimeFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextBrush}" />
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
