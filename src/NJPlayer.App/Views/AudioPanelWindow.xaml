<Window x:Class="NJPlayer.App.Views.AudioPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Equalizer - NJ Player"
        Height="460" Width="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Custom Vertical Slider Style for Equalizer -->
        <Style x:Key="EqVerticalSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="TickFrequency" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center">
                            <!-- Track line -->
                            <Border Width="4" Background="{StaticResource SurfaceBrush}" CornerRadius="2" HorizontalAlignment="Center">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#252E39" />
                                </Border.BorderBrush>
                            </Border>

                            <!-- Center 0dB indicator tick -->
                            <Border Width="12" Height="1" Background="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5" />

                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{StaticResource AccentBrush}" Stroke="{StaticResource BgBrush}" StrokeThickness="2" />
                                                    <Ellipse Width="4" Height="4" Fill="{StaticResource BgBrush}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceRaisedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLg}"
            Padding="0"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="12" Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎚 Equalizer &amp; Audio Suite" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <CheckBox x:Name="EnableEqCheckBox" Content="Enabled" IsChecked="True" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="20,0,0,0" VerticalAlignment="Center" Checked="EnableEq_Changed" Unchecked="EnableEq_Changed" Cursor="Hand" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CloseCaptionButtonStyle}" Click="Close_Click">
                        <TextBlock Text="✕" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <!-- 10-Band Graphic Equalizer Section -->
            <Grid Grid.Row="1" Margin="20,16,20,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Presets dropdown and header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PRESETS: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="PresetsCombo" Width="160" Margin="10,0,0,0" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" SelectionChanged="PresetsCombo_SelectionChanged" Cursor="Hand" />
                    </StackPanel>
                    <TextBlock Text="+12 dB ... -12 dB" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- 10 Vertical Bands -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Band 0: 31 Hz -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock x:Name="GainText0" Text="0 dB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Height="16" />
                        <Slider x:Name="Slider0" Style="{StaticResource EqVerticalSliderStyle}" Height="150" Margin="0,6" ValueChanged="BandSlider_ValueChanged" Tag="0" />
                        <TextBlock Text="31" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Hz" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Band 1: 62 Hz -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="GainText1" Text="0 dB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Height="16" />
                        <Slider x:Name="Slider1" Style="{StaticResource EqVerticalSliderStyle}" Height="150" Margin="0,6" ValueChanged="BandSlider_ValueChanged" Tag="1" />
                        <TextBlock Text="62" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Hz" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Band 2: 125 Hz -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="GainText2" Text="0 dB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Height="16" />
                        <Slider x:Name="Slider2" Style="{StaticResource EqVerticalSliderStyle}" Height="150" Margin="0,6" ValueChanged="BandSlider_ValueChanged" Tag="2" />
                        <TextBlock Text="125" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Hz" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Band 3: 250 Hz -->
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock x:Name="GainText3" Text="0 dB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Height="16" />
                        <Slider x:Name="Slider3" Style="{StaticResource EqVerticalSliderStyle}" Height="150" Margin="0,6" ValueChanged="BandSlider_ValueChanged" Tag="3" />
                        <TextBlock Text="250" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Hz" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Band 4: 500 Hz -->
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock x:Name="GainText4" Text="0 dB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Height="16" />
                        <Slider x:Name="Slider4" Style="{StaticResource EqVerticalSliderStyle}" Height="150" Margin="0,6" ValueChanged="BandSlider_ValueChanged" Tag="4" />
                        <TextBlock Text="500" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Hz" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Band 5: 1 kHz -->
                    <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                        <TextBlock x:Name="GainText5" Text="0 dB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Height="16" />
                        <Slider x:Name="Slider5" Style="{StaticResource EqVerticalSliderStyle}" Height="150" Margin="0,6" ValueChanged="BandSlider_ValueChanged" Tag="5" />
                        <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="kHz" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Band 6: 2 kHz -->
                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                        <TextBlock x:Name="GainText6" Text="0 dB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Height="16" />
                        <Slider x:Name="Slider6" Style="{StaticResource EqVerticalSliderStyle}" Height="150" Margin="0,6" ValueChanged="BandSlider_ValueChanged" Tag="6" />
                        <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="kHz" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Band 7: 4 kHz -->
                    <StackPanel Grid.Column="7" HorizontalAlignment="Center">
                        <TextBlock x:Name="GainText7" Text="0 dB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Height="16" />
                        <Slider x:Name="Slider7" Style="{StaticResource EqVerticalSliderStyle}" Height="150" Margin="0,6" ValueChanged="BandSlider_ValueChanged" Tag="7" />
                        <TextBlock Text="4" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="kHz" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Band 8: 8 kHz -->
                    <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                        <TextBlock x:Name="GainText8" Text="0 dB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Height="16" />
                        <Slider x:Name="Slider8" Style="{StaticResource EqVerticalSliderStyle}" Height="150" Margin="0,6" ValueChanged="BandSlider_ValueChanged" Tag="8" />
                        <TextBlock Text="8" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="kHz" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Band 9: 16 kHz -->
                    <StackPanel Grid.Column="9" HorizontalAlignment="Center">
                        <TextBlock x:Name="GainText9" Text="0 dB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Height="16" />
                        <Slider x:Name="Slider9" Style="{StaticResource EqVerticalSliderStyle}" Height="150" Margin="0,6" ValueChanged="BandSlider_ValueChanged" Tag="9" />
                        <TextBlock Text="16" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="kHz" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Secondary Tone & Dynamics Section (Bass Boost, Treble, Night Mode) -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Bass Boost -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <Grid>
                            <TextBlock Text="Bass Boost (100 Hz)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="BassText" Text="+0.0 dB" FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="BassSlider" Style="{StaticResource PlayerSliderStyle}" Minimum="0" Maximum="12" Value="0" Margin="0,6,0,0" ValueChanged="BassSlider_ValueChanged" />
                    </StackPanel>

                    <!-- Treble -->
                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <Grid>
                            <TextBlock Text="Treble (3 kHz)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="TrebleText" Text="0.0 dB" FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider x:Name="TrebleSlider" Style="{StaticResource PlayerSliderStyle}" Minimum="-12" Maximum="12" Value="0" Margin="0,6,0,0" ValueChanged="TrebleSlider_ValueChanged" />
                    </StackPanel>

                    <!-- Night Mode -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="10,6" VerticalAlignment="Center">
                        <StackPanel>
                            <CheckBox x:Name="NightModeCheckBox" Content="Night Mode" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}" Cursor="Hand" Checked="NightMode_Changed" Unchecked="NightMode_Changed" />
                            <TextBlock Text="DynAudNorm compression" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="20,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Footer: Reset and Close -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,12,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <Button Content="Reset to Flat" Style="{StaticResource IconButton}" Width="110" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Left" Click="Reset_Click" />
                    <Button Content="Close" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="80" Click="Close_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

