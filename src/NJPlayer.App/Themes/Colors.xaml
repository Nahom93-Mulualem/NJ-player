<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DESIGN.md Colors -->
    <Color x:Key="BgColor">#0B0E12</Color>
    <Color x:Key="SurfaceColor">#12171D</Color>
    <Color x:Key="SurfaceRaisedColor">#1A212A</Color>
    <Color x:Key="BorderColor">#252E39</Color>
    <Color x:Key="TextColor">#E6EDF3</Color>
    <Color x:Key="TextMutedColor">#8B98A5</Color>
    <Color x:Key="AccentColor">#00E5FF</Color>
    <Color x:Key="AccentHoverColor">#5CF0FF</Color>
    <Color x:Key="AccentPressedColor">#00B8CC</Color>
    <Color x:Key="OnAccentColor">#001418</Color>
    <Color x:Key="DangerColor">#FF5C6C</Color>
    <Color x:Key="SuccessColor">#3DDC97</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface85Brush" Color="#D912171D" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <!-- Overlay Gradients -->
    <LinearGradientBrush x:Key="BottomBarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000B0E12" Offset="0.0" />
        <GradientStop Color="#800B0E12" Offset="0.3" />
        <GradientStop Color="#EB0B0E12" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="TitleFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="TimeFont">Consolas, Cascadia Mono, monospace</FontFamily>

    <!-- Corner Radii -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

</ResourceDictionary>

