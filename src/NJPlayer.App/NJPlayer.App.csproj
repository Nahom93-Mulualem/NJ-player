<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <RootNamespace>NJPlayer.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NJPlayer.Core\NJPlayer.Core.csproj" />
    <ProjectReference Include="..\NJPlayer.Features\NJPlayer.Features.csproj" />
  </ItemGroup>

  <!-- Post-build step: Copy external native binaries (libmpv-2.dll, ffmpeg.exe, ffprobe.exe, yt-dlp.exe) next to the exe -->
  <Target Name="CopyExternalLibs" AfterTargets="Build">
    <ItemGroup>
      <ExternalLibs Include="$(MSBuildThisFileDirectory)..\..\libs\*.dll;$(MSBuildThisFileDirectory)..\..\libs\*.exe;$(MSBuildThisFileDirectory)..\..\libs\mpv\*.dll;$(MSBuildThisFileDirectory)..\..\libs\**\libmpv*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ExternalLibs)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'@(ExternalLibs)' != ''" />
  </Target>
</Project>
