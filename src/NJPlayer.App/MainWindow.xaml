<Window x:Class="NJPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NJPlayer.App.Views"
        mc:Ignorable="d"
        Title="NJ Player" Height="580" Width="980"
        Icon="Assets/app.ico"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <!-- WindowChrome for modern Windows frameless styling with native snap & resize edges -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 1px outline border per DESIGN.md section 2 -->
    <Border x:Name="WindowOutline" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Background="{StaticResource BgBrush}">
            <!-- Native Win32 child window hosting mpv video surface -->
            <views:VideoHost x:Name="PlayerHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Empty State Placeholder (Visible when no video is playing) -->
            <Border x:Name="EmptyStateOverlay" Background="{StaticResource BgBrush}" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Assets/logo.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="NJ Player" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop a video file here or press Ctrl+O" FontSize="14" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                    <!-- Missing libmpv notice (hidden by default, shown if DLL is not in libs/ or app directory) -->
                    <Border x:Name="DllNoticeBorder" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,24,0,0" Visibility="Collapsed" MaxWidth="520">
                        <StackPanel>
                            <TextBlock Text="⚠️ libmpv-2.dll Not Found" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" FontSize="13"/>
                            <TextBlock Text="To enable video playback, download 64-bit libmpv-2.dll and place it into the 'libs' folder or directly next to the exe." TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
