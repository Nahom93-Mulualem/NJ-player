<Window x:Class="NJPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NJ Player" Height="540" Width="960"
        Icon="Assets/app.ico"
        Background="#0B0E12" Foreground="#E6EDF3"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="Assets/logo.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="NJ Player" FontSize="28" FontWeight="SemiBold" Foreground="#00E5FF" HorizontalAlignment="Center"/>
            <TextBlock Text="Fast. Dark. Yours." FontSize="14" Foreground="#8B98A5" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>
