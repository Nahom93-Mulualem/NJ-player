<Window x:Class="NJPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NJPlayer.App.Views"
        mc:Ignorable="d"
        Title="NJ Player" Height="580" Width="980"
        MinWidth="480" MinHeight="270"
        Icon="Assets/app.ico"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <!-- WindowChrome for modern Windows frameless styling with native snap & resize edges -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 1px outline border per DESIGN.md section 2 -->
    <Border x:Name="WindowOutline" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid Background="{StaticResource BgBrush}">
            <!-- Native Win32 child window hosting mpv video surface (collapsed by default to prevent airspace blank window) -->
            <views:VideoHost x:Name="PlayerHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" />

            <!-- Dedicated MP3 / Music Player Hero Surface (Default startup view: Album Cover view) -->
            <Border x:Name="MusicHeroSurface" Background="{StaticResource BgBrush}" Visibility="Visible">
                <Grid>
                    <!-- Subtle Background Photo/Video Backdrop (Low opacity, soft dark vignette glow) -->
                    <Grid x:Name="MusicBackdropContainer" IsHitTestVisible="False">
                        <Image x:Name="MusicBackdropImage" Stretch="UniformToFill" Opacity="0.22" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border Background="{StaticResource BgBrush}" Opacity="0.65" />
                    </Grid>

                    <!-- Main Track & Album Art Content -->
                    <Grid Margin="32,24,32,96">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="840">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Album Art Container with soft drop shadow and cyan ambient glow -->
                            <Border Grid.Column="0" Width="260" Height="260" CornerRadius="{StaticResource RadiusLg}"
                                    Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="28" Opacity="0.18" ShadowDepth="4" Direction="270" />
                                </Border.Effect>
                                <Grid ClipToBounds="True">
                                    <!-- Default cover with NJ Logo (shown if song has no album art) -->
                                    <Grid x:Name="AlbumArtPlaceholder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource SurfaceBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="Assets/logo.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="NJ PLAYER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="AUDIO" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Extracted or Sidecar Album Art Image -->
                                    <Image x:Name="AlbumArtImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>

                            <!-- Track Metadata & Lyrics Column -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="490">
                                <!-- Quality & Codec Badges -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8,3" Margin="0,0,8,0">
                                        <TextBlock x:Name="MusicQualityBadgeText" Text="AUDIO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                    <Button x:Name="ToggleMusicVisualizerBtn" Content="📊 Visualizer Mode" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="8,0" FontSize="11" Click="ToggleMusicVisualizer_Click" Margin="0,0,6,0" />
                                    <Button x:Name="PickBackgroundBtn" Content="🌄 Background" Style="{StaticResource CaptionButtonStyle}" Height="24" Padding="8,0" FontSize="11" Click="PickBackgroundBtn_Click" ToolTip="Set custom background photo or video (jpg, png, mp4)" />
                                </StackPanel>

                                <!-- Song Title -->
                                <TextBlock x:Name="MusicTitleText" Text="Track Title" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />

                                <!-- Artist & Album -->
                                <TextBlock x:Name="MusicArtistAlbumText" Text="Artist — Album" FontSize="14" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,16" />

                                <!-- 3-Line Synchronized Lyrics Surface -->
                                <Border x:Name="LyricsContainer" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="16,12" MinHeight="96">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="LyricPrevText" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Opacity="0.45" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                        <TextBlock x:Name="LyricCurrentText" Text="♪ Music playing" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        <TextBlock x:Name="LyricNextText" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Opacity="0.45" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Minimal Smooth Animated Visualizer Strip near bottom (non-intrusive, reliable) -->
                    <Border x:Name="VisualizerStripBorder" VerticalAlignment="Bottom" Height="56" Margin="32,0,32,24"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusMd}" Padding="16,8">
                        <Border.Effect>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="20" Opacity="0.14" ShadowDepth="2" Direction="270" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock x:Name="VisualizerStatusIcon" Text="📊" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="VisualizerStatusLabel" Text="Spectrum Bars" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Animated Visualizer Canvas -->
                            <Canvas Grid.Column="1" x:Name="VisualizerCanvas" Height="36" ClipToBounds="True" SizeChanged="VisualizerCanvas_SizeChanged" />

                            <!-- Style Switcher Pill -->
                            <Button Grid.Column="2" x:Name="VisualizerCycleBtn" Style="{StaticResource CaptionButtonStyle}" Height="24" Padding="8,0" Click="VisualizerCycleBtn_Click" ToolTip="Switch visualizer animation style" Margin="14,0,0,0">
                                <TextBlock x:Name="VisualizerCycleBtnText" Text="Bars ▾" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Empty State Placeholder (Visible only in video mode when no video is playing) -->
            <Border x:Name="EmptyStateOverlay" Background="{StaticResource BgBrush}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="140" Height="140" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="36" Opacity="0.28" ShadowDepth="4" Direction="270" />
                        </Border.Effect>
                        <Image Source="Assets/logo.png" Width="136" Height="136" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="NJ Player" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Drop a video or audio file here or press Ctrl+O" FontSize="14" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                    <!-- Recent Files List -->
                    <StackPanel x:Name="RecentFilesPanel" Margin="0,20,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="RECENT FILES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <ItemsControl x:Name="RecentFilesList" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DisplayName}" Tag="{Binding FullPath}" Style="{StaticResource TextGhostButton}" HorizontalAlignment="Center" Margin="0,1" Click="RecentFile_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Missing libmpv notice (hidden by default, shown if DLL is not in libs/ or app directory) -->
                    <Border x:Name="DllNoticeBorder" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,24,0,0" Visibility="Collapsed" MaxWidth="520">
                        <StackPanel>
                            <TextBlock Text="⚠️ libmpv.dll / libmpv-2.dll Not Found" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" FontSize="13"/>
                            <TextBlock Text="To enable playback, please make sure 64-bit libmpv.dll (or libmpv-2.dll) is placed next to NJPlayer.App.exe or in the 'libs' folder." TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
